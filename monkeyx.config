# MonkeyX Module Configuration
# Uncomment any line to override the default value.
# Priority: this file < workflow YAML step args < CLI flags

# ── Fleet / Axiom (global, non-module settings) ────────────────
fleet:
  # instance_type: e2-medium      # Cloud instance/server size of your axiom
  #                               # fleet nodes. MonkeyX can't read this from the
  #                               # provider, so set it here to have it printed in
  #                               # the cost summary (logs/costs-*.txt) and the
  #                               # scan debrief's "Cost & Compute" section — the
  #                               # report shows node-hours, so a reader multiplies
  #                               # by this size's hourly rate to get fleet cost.
  # account: myaccount            # Axiom account name for authentication.
  #                               # Resolution order (highest wins):
  #                               #   --ax-account flag > AXIOM_ACCOUNT env > this.
  #                               # Set it here to avoid exporting the env var or
  #                               # passing the flag on every run.
  # ax_timeout: 28800             # OPTIONAL global backstop (seconds) for every
  #                               # `ax scan`. Default UNSET = no limit (nothing
  #                               # is capped). Only use this as a last-resort
  #                               # guard against a hung node; it MUST exceed your
  #                               # longest legitimate scan — a full nmap -p all
  #                               # or nuclei run across a large fleet can take
  #                               # HOURS, and a too-low value kills good runs.
  #                               # On timeout the whole process group (incl.
  #                               # fleet SSH children) is killed, the step is
  #                               # marked failed, and the run continues. Prefer a
  #                               # per-module modules.<name>.timeout (below) so a
  #                               # fast enum tool can be bounded tightly without
  #                               # capping the slow port/vuln scanners.
  #
  # --- auto-scale sizing (--auto-scale) ---
  # targets_per_node: 60          # host-class workload (IPs) per fleet node.
  # urls_per_node: 150            # URL-class workload per fleet node.
  # cidr_host_cap: 1024           # When sizing from -t, a CIDR counts as
  #                               # min(hosts_in_range, this) host-equivalents —
  #                               # so a /16 opens a bigger fleet than one IP
  #                               # without demanding one node per address for
  #                               # mostly-empty space. 0 = legacy (a CIDR counts
  #                               # as 1 target). --max-nodes still caps the total.

scan:
  # sweep: true                   # Sweep-then-verify: run a fast masscan sweep,
  #                               # then nmap -sV/NSE on only the open ports/live
  #                               # hosts (the standard workflow uses this). Set
  #                               # false to disable globally — nmap then scans
  #                               # top-1000 directly, no masscan. The --no-sweep
  #                               # CLI flag overrides this per run. Default: true.
  # min_free_disk_gb: 20          # `monkeyx --check` warns when the output
  #                               # volume has less than this much free disk (a
  #                               # deep/large scan can ENOSPC-cascade). A hard
  #                               # error floor of 5 GB is always enforced.
  # masscan_tarpit_port_cap: 500  # A host reporting more than this many open
  #                               # ports in the masscan sweep is treated as a
  #                               # tarpit/SYN-proxy: logged alive but its ports
  #                               # are NOT ingested (so they can't bloat the
  #                               # ledger or poison the nmap `ports: open`
  #                               # verify step). 0 disables the guard. Default: 500.

modules:

  # ── Port Scanning ──────────────────────────────────────────────
  ax_nmap_tcp:
    # ports: top-5000              # top-N, 1-65535, or 80,443,8080
    # scripts: true                # true | false (NSE `default` set + reverse-index)
    # vuln_scripts: false          # add the slow/noisy 'vuln and safe' (vulners) set
    # version: full                # full | light | false
    # version_intensity: 5         # -sV probe depth 0-9 (nmap default 7; lower = faster)
    # max_retries: 3               # nmap --max-retries (its -T4 default ~10; lower = faster)
    # min_rate:                    # nmap --min-rate pkts/sec (blank = adaptive)
    # timing: T4                   # T0-T5 (avoid T5 on remote targets)
    # host_timeout: 60m            # per-host cap, e.g. 60m | 600s | 1h (lower on huge scopes)
    # connect_fallback: false      # re-scan up-but-0-port hosts with -sT (SYN-filter/rate-limit recovery)
    #                              # re-scans the SAME ports as the primary (the `ports:` set above, default top-1000)
    # connect_fallback_max_hosts: 32  # cap so a large empty scope can't trigger a slow -sT sweep

  ax_nmap_udp:
    # ports: top-200               # top-N or comma-separated list
    # max_retries: 2               # UDP retransmits dominate runtime; keep low
    # min_rate:                    # nmap --min-rate pkts/sec (blank = adaptive)
    # timing: T4                   # T0-T5
    # host_timeout: 60m            # per-host cap, e.g. 60m | 600s

  ax_masscan:
    # ports: top-1000              # all | top-N | comma-separated list
    # rate: 10000                  # packets per second

  ax_naabu:
    # ports: all                   # all | top-100 | top-1000 | comma-separated list.
    #                              # NOTE: naabu's -top-ports only supports the 100/1000
    #                              # presets (not arbitrary top-N) — for e.g. "top 1024"
    #                              # use an explicit range like 1-1024, or ax_masscan.
    # rate: 5000                   # packets per second

  # ── Web Discovery ──────────────────────────────────────────────
  ax_gowitness:
    # threads: 2                   # concurrent headless Chromium (low = less RAM on 2GB nodes)
    # timeout: 3600                # wall-clock backstop (s) for a hung Chromium node

  ax_ffuf:
    # wordlist: /home/op/lists/seclists/Discovery/Web-Content/common.txt
    # threads: 80                  # concurrent threads per target
    # timeout: 3600                # wall-clock backstop (seconds)

  ax_feroxbuster:
    # wordlist: /home/op/lists/seclists/Discovery/Web-Content/common.txt
    # feroxbuster recurses by default — these bound it so it can't run forever on
    # a wildcard/soft-404 host (the "freezing" symptom). Defaults: depth 2,
    # time-limit 15m, auto-bail on. Set tuning:false to send NONE of these (if
    # your ax build doesn't forward tool flags — then set them in the ax module).
    # tuning: true                 # false = plain invocation, no extra flags
    # depth: 2                     # recursion depth cap (0 = feroxbuster default)
    # time_limit: 15m              # hard stop per scan (e.g. 30s/15m/2h)
    # auto_bail: true              # bail on a target that floods errors
    # scan_limit: 0                # max concurrent dir scans (0 = unset)
    # timeout: 3600                # wall-clock backstop (s) for the whole ax fan-out
    # threads: 0                   # (0 = feroxbuster default)
    # rate_limit: 0                # requests/sec cap (0 = unset)

  ax_dalfox:
    # dalfox is otherwise unbounded (a real run took 4.5h on 743 URLs for 2
    # findings). Defaults skip BAV + dictionary param-mining (ax_arjun already
    # surfaces real params) and cap concurrency + per-request timeout, plus a
    # wall-clock backstop. Set tuning:false to run raw dalfox.
    # tuning: true                 # false = no dalfox flags (raw)
    # skip_bav: true               # skip SQLi/SSTI/redirect/CRLF side-probes
    # skip_mining: true            # skip the ~2500-name dictionary (keeps DOM mining)
    # worker: 30                   # concurrent workers per node (dalfox default 100)
    # req_timeout: 5               # per-request timeout (s); dalfox default 10
    # timeout: 3600                # wall-clock backstop (s) for the whole ax fan-out

  # ── DNS / Subdomains ───────────────────────────────────────────
  ax_puredns_bruteforce:
    # wordlist: /home/op/lists/seclists/Discovery/DNS/subdomains-top1million-110000.txt

  # ── Enrichment (Shodan / Censys / GreyNoise) ───────────────────
  # API keys live in ~/.monkeyx/credentials.yaml (enrichment.<provider>.api_key)
  # or MONKEYX_<PROVIDER>_API_KEY env vars — NOT here.
  shodan_enrich:
    # searches: false              # true = spend query credits on pivot searches
    # search_org: true             # org:/hostname: pivots     (only if searches on)
    # search_cert: true            # ssl.cert.subject.CN pivots (only if searches on)
    # search_favicon: true         # favicon-hash pivots        (only if searches on)
    # history: false               # per-host ?history=true
    # max_query_credits: 50        # hard cap on Search-API credits per scan
    # providers: [shodan]          # add censys/greynoise when keys are configured

  # ── AI Analysis ────────────────────────────────────────────────
  ai_analyze:
    # ai_depth: standard           # quick | standard | balanced | deep | unlimited
    # ai_max_hosts: 50             # integer or unlimited
    # ai_max_services: 25          # integer or unlimited
    # ai_max_findings_per_host: 25 # integer or unlimited
    # ai_max_web_dirs_per_host: 10 # integer or unlimited
    # ai_max_tokens: 60000         # max tokens per AI call
    # ai_provider: anthropic       # anthropic | openai | ollama | claude-code
    # kb_max_tokens: 4000          # knowledge base token budget per injection
    # ai_multipass: false          # true = pure + KB-grounded passes, reconciled (see --multi-pass)

  ai_validate:
    # max_validate: 25             # max FINDINGS validated per run
    # max_attempts: 6              # tool-call budget PER finding (int or "unlimited").
    #                              # "max validation attempts reached" = this was hit;
    #                              # raise it if the agent needs more probes to decide.
    # kb_max_tokens: 2000          # knowledge base token budget per finding
    # rebuttal: false              # true = adversarial 2nd-agent pass (see --rebuttal)
