# MonkeyX Credentials Configuration
# Copy this file to ~/.monkeyx/credentials.yaml and fill in your keys.
# Environment variables override file values (see comments below).

ai:
  # Which provider to use by default (anthropic, openai, ollama, claude-code)
  # Override: MONKEYX_AI_PROVIDER=anthropic
  default_provider: anthropic

  anthropic:
    # Option 1: Direct Anthropic API — uncomment and set your real key.
    # Leave it commented (not a placeholder value) if unused: a present-but-fake
    # key is treated as real and fails with an auth error, which is harder to
    # diagnose than a cleanly-absent key.
    # Override: MONKEYX_AI_API_KEY=sk-ant-...
    # api_key: sk-ant-...

    # Option 2: AWS Bedrock (comment out api_key above, uncomment aws_region)
    # Requires: pip install 'anthropic[bedrock]>=0.40.0'
    # aws_region: us-east-1
    #
    # By default Bedrock uses the ambient AWS credential chain (env vars,
    # ~/.aws/credentials, or the instance role). If those creds belong to a
    # DIFFERENT account than Bedrock — e.g. the Axiom fleet runs in one AWS
    # account and Bedrock lives in another — give Bedrock its own identity here
    # so it doesn't inherit the fleet creds and 403.
    #
    # MOST ROBUST — explicit keys for the Bedrock account. Passed straight to the
    # client, so they override the ambient chain unconditionally (incl. AWS_*
    # environment variables):
    # aws_access_key: AKIA...
    # aws_secret_key: ...
    # aws_session_token: ...        # only if using temporary/STS creds
    #
    # OR name an ~/.aws profile (supports assume-role into the Bedrock account):
    # aws_profile: bedrock
    #   CAVEAT: a named profile does NOT override AWS_ACCESS_KEY_ID /
    #   AWS_SECRET_ACCESS_KEY set in the ENVIRONMENT — botocore's env provider
    #   wins over a profile, so Bedrock would still pick up the ambient (fleet)
    #   creds and 403. Only use aws_profile when the conflicting creds live in
    #   ~/.aws (a different profile) or the instance role — not in env vars. If in
    #   doubt (`env | grep AWS_` shows keys), use the explicit keys above.

    # Override: MONKEYX_AI_MODEL=claude-opus-4-6
    model: claude-opus-4-6

    # --- Cost estimation (optional) ---
    # MonkeyX estimates AI cost from token usage. It can auto-detect the rate for
    # a named model or a Bedrock inference-profile ARN that embeds the model name
    # (…/us.anthropic.claude-sonnet-4-…). But an APPLICATION-inference-profile ARN
    # (…/application-inference-profile/exampleprofileid) carries NO model name, so the
    # rate can't be inferred — set ONE of the following or cost shows as N/A:
    #
    #   model_family: sonnet          # easiest — borrow built-in rates
    #                                 # (sonnet | opus | haiku | gpt-4o | gpt-4o-mini)
    #   # OR set exact per-1,000,000-token USD prices (these win over model_family):
    #   # input_price_per_1m: 3.0
    #   # output_price_per_1m: 15.0
    #
    # max_output_tokens: 128000       # optional — the model's max_tokens (reply
    #                                 # length) cap. Defaults to 128000 (current
    #                                 # max-size Claude). Lower it only if your
    #                                 # model caps below that (else Bedrock 400s
    #                                 # on the deep/unlimited presets).
    #
    # context_window: 1000000         # optional — the model's INPUT context window
    #                                 # in tokens (drives ai_analyze host batching).
    #                                 # On Bedrock this defaults to 200000 because
    #                                 # the 1M-token window is a gated beta; if your
    #                                 # account/region/model HAS the 1M beta enabled,
    #                                 # set 1000000 here to stop the per-run clamp.
    #                                 # Direct Anthropic API defaults to 1000000.

  openai:
    # Uncomment and set to use OpenAI (or MONKEYX_AI_API_KEY).
    # api_key: sk-...
    model: gpt-4o

  ollama:
    # No API key needed for local Ollama
    base_url: http://localhost:11434
    model: llama3:70b

  claude-code:
    # No API key needed — uses your existing Claude Code CLI authentication.
    # Requires `claude` CLI to be installed and authenticated.
    # model: sonnet | opus | haiku (or full model ID like claude-opus-4-6)
    model: sonnet
    # max_turns: agentic iteration cap. Engine default is 3 if this key is
    # omitted; template ships 1 for cheaper single-shot analysis.
    max_turns: 1

# Enrichment providers are OPTIONAL. Uncomment a key only when you have a real
# one — leaving a placeholder VALUE uncommented makes the module treat it as a
# configured key, then every lookup fails auth and the run looks like "nothing
# found" instead of "no key". Absent (commented) = the module skips cleanly.
enrichment:
  shodan:
    # Override: MONKEYX_SHODAN_API_KEY=...
    # api_key: ...

  censys:
    # Override: MONKEYX_CENSYS_API_KEY=...
    # api_id: ...
    # api_secret: ...

  greynoise:
    # Override: MONKEYX_GREYNOISE_API_KEY=...
    # api_key: ...

  virustotal:
    # Override: MONKEYX_VIRUSTOTAL_API_KEY=...
    # api_key: ...
